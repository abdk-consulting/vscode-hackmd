{
  "name": "vscode-hackmd",
  "displayName": "HackMD",
  "description": "The official HackMD Markdown VSCode extension",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "publisher": "HackMD",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#333333",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:hackmd.tree.my-notes",
    "onView:hackmd.tree.recent-notes",
    "onView:hackmd.tree.team-notes",
    "onCommand:HackMD.apiKey",
    "onCommand:HackMD.clearApiKey",
    "onCommand:HacKMD.openNoteOnHackMD",
    "onFileSystem:hackmd"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hackmdio/vscode-hackmd/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/hackmdio/vscode-hackmd/issues",
    "email": "support@hackmd.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hackmdio/vscode-hackmd.git"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "HackMD",
      "properties": {
        "Hackmd.apiEndPoint": {
          "type": "string",
          "default": "https://api.hackmd.io/v1/",
          "markdownDescription": "Specify the API endpoint for official instance or HackMD EE"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/page.js"
    ],
    "markdown.previewStyles": [
      "./dist/page.css"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackmd-tree",
          "title": "HackMD Notes",
          "icon": "images/icon/activity-bar.svg"
        }
      ]
    },
    "views": {
      "hackmd-tree": [
        {
          "id": "hackmd.tree.my-notes",
          "name": "My Notes"
        },
        {
          "id": "hackmd.tree.team-notes",
          "name": "Team Notes"
        },
        {
          "id": "hackmd.tree.recent-notes",
          "name": "Recent Notes"
        },
        {
          "id": "hackmd.properties",
          "name": "Note Properties",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "HackMD.apiKey",
        "title": "API Key",
        "category": "HackMD"
      },
      {
        "command": "HackMD.clearApiKey",
        "title": "Clear API Key",
        "category": "HackMD"
      },
      {
        "command": "HackMD.upgrade",
        "title": "Upgrade",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.refreshAll",
        "title": "Refresh All Data",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.refreshPersonalScope",
        "title": "Refresh",
        "category": "HackMD Model",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "hackmd.model.refreshTeams",
        "title": "Refresh",
        "category": "HackMD Model",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "hackmd.model.refreshHistory",
        "title": "Refresh",
        "category": "HackMD Model",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "hackmd.model.refreshScope",
        "title": "Refresh",
        "category": "HackMD Model",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "hackmd.model.getScopeSnapshot",
        "title": "Get Scope Snapshot",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getNote",
        "title": "Get Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getNoteContent",
        "title": "Get Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getEntityByUri",
        "title": "Get Entity By URI",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.createNote",
        "title": "Create Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.createFolder",
        "title": "Create Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.createMyNote",
        "title": "Create Note in My Notes",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.createTeamNote",
        "title": "Create Note in Team",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.createMyFolder",
        "title": "Create Folder in My Notes",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.createTeamFolder",
        "title": "Create Folder in Team",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.loadNoteContent",
        "title": "Load Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.saveNoteContent",
        "title": "Save Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.updateNoteProperties",
        "title": "Update Note Properties",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.renameNote",
        "title": "Rename Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.renameFolder",
        "title": "Rename Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.updateFolder",
        "title": "Update Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.move",
        "title": "Move",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.duplicateNote",
        "title": "Duplicate",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.delete",
        "title": "Delete",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.ui.edit",
        "title": "Edit",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.preview",
        "title": "Preview",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.sideBySide",
        "title": "Side by Side",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.openOnHackMD",
        "title": "Open on HackMD",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.import",
        "title": "Import",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.importToMyNotes",
        "title": "Import to My Notes",
        "category": "HackMD"
      },
      {
        "command": "hackmd.ui.importToTeam",
        "title": "Import to Team",
        "category": "HackMD"
      },
      {
        "command": "hackmd.ui.export",
        "title": "Export",
        "category": "HackMD UI"
      },
      {
        "command": "hackmd.ui.properties",
        "title": "Properties...",
        "category": "HackMD UI"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hackmd.model.refreshPersonalScope",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@3"
        },
        {
          "command": "hackmd.model.refreshHistory",
          "when": "view =~ /hackmd.tree.recent-notes/",
          "group": "navigation"
        },
        {
          "command": "hackmd.model.refreshTeams",
          "when": "view =~ /hackmd.tree.team-notes/",
          "group": "navigation"
        },
        {
          "command": "hackmd.model.createMyNote",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@1"
        },
        {
          "command": "hackmd.model.createMyFolder",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@2"
        },
        {
          "command": "hackmd.ui.import",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "hackmd.ui.edit",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@1"
        },
        {
          "command": "hackmd.ui.edit",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@1"
        },
        {
          "command": "hackmd.ui.preview",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@2"
        },
        {
          "command": "hackmd.ui.preview",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@2"
        },
        {
          "command": "hackmd.ui.sideBySide",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@3"
        },
        {
          "command": "hackmd.ui.sideBySide",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@3"
        },
        {
          "command": "hackmd.ui.openOnHackMD",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@4"
        },
        {
          "command": "hackmd.model.renameNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@2"
        },
        {
          "command": "hackmd.ui.properties",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@1"
        },
        {
          "command": "hackmd.model.move",
          "when": "(viewItem == file && ((view == hackmd.tree.my-notes && ((!hackmd.myNotesSelection.hasMixedSelection && (!hackmd.myNotesSelection.hasMultiNoteSelection || hackmd.myNotesSelection.hasSameScopeMultiNoteSelection)) || (hackmd.myNotesSelection.hasMixedSelection && hackmd.myNotesSelection.hasActionableSelection && hackmd.myNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.team-notes && ((!hackmd.teamNotesSelection.hasMixedSelection && (!hackmd.teamNotesSelection.hasMultiNoteSelection || hackmd.teamNotesSelection.hasSameScopeMultiNoteSelection)) || (hackmd.teamNotesSelection.hasMixedSelection && hackmd.teamNotesSelection.hasActionableSelection && hackmd.teamNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && (!hackmd.historySelection.hasMultiNoteSelection || hackmd.historySelection.hasSameScopeMultiNoteSelection))))",
          "group": "2_noteActions@3"
        },
        {
          "command": "hackmd.model.duplicateNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@4"
        },
        {
          "command": "hackmd.ui.export",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@5"
        },
        {
          "command": "hackmd.model.delete",
          "when": "(viewItem == file && ((view == hackmd.tree.my-notes && hackmd.myNotesSelection.hasActionableSelection) || (view == hackmd.tree.team-notes && hackmd.teamNotesSelection.hasActionableSelection) || (view == hackmd.tree.recent-notes && hackmd.historySelection.hasActionableSelection)))",
          "group": "9_noteDanger@1"
        },
        {
          "command": "hackmd.model.createNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@1"
        },
        {
          "command": "hackmd.model.createFolder",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@2"
        },
        {
          "command": "hackmd.ui.import",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@3"
        },
        {
          "command": "hackmd.model.createNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "1_folderMain@1"
        },
        {
          "command": "hackmd.model.createFolder",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "1_folderMain@2"
        },
        {
          "command": "hackmd.ui.openOnHackMD",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending)",
          "group": "1_folderMain@3"
        },
        {
          "command": "hackmd.model.renameFolder",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "2_folderManage@1"
        },
        {
          "command": "hackmd.model.move",
          "when": "(viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending) && ((view == hackmd.tree.my-notes && (!hackmd.myNotesSelection.hasSelection || (hackmd.myNotesSelection.hasActionableSelection && hackmd.myNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.team-notes && (!hackmd.teamNotesSelection.hasSelection || (hackmd.teamNotesSelection.hasActionableSelection && hackmd.teamNotesSelection.hasSingleScopeActionableSelection))))",
          "group": "2_folderManage@2"
        },
        {
          "command": "hackmd.ui.import",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "2_folderManage@3"
        },
        {
          "command": "hackmd.ui.export",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "2_folderManage@4"
        },
        {
          "command": "hackmd.model.delete",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "3_folderDanger@1"
        },
        {
          "command": "hackmd.model.createNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@1"
        },
        {
          "command": "hackmd.model.createFolder",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@2"
        },
        {
          "command": "hackmd.ui.import",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@3"
        },
        {
          "command": "hackmd.model.createNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@1"
        },
        {
          "command": "hackmd.model.createFolder",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@2"
        },
        {
          "command": "hackmd.ui.openOnHackMD",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@3"
        },
        {
          "command": "hackmd.model.refreshScope",
          "when": "view == hackmd.tree.team-notes && viewItem == team-loaded",
          "group": "1_teamMain@4"
        },
        {
          "command": "hackmd.model.refreshScope",
          "when": "view == hackmd.tree.team-notes && viewItem == team-loaded",
          "group": "inline@4"
        },
        {
          "command": "hackmd.ui.import",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "2_teamTransfer@1"
        },
        {
          "command": "hackmd.ui.export",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "2_teamTransfer@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode none",
    "watch": "webpack --mode none --progress --watch",
    "test-compile": "tsc -p ./",
    "test:model:compile": "tsc --ignoreConfig --pretty false --module commonjs --target es2020 --lib es2020,dom --outDir out --rootDir src --sourceMap --strict false --allowSyntheticDefaultImports --allowArbitraryExtensions --types node,jquery src/model/index.ts src/model/hackmdModel.ts src/commands/pickers.ts src/commands/model.ts src/commands/ui.ts",
    "test": "npm run test:model && npm run test:commands && npm run test:tree:dnd && npm run test:fs:provider && npm run test:properties && npm run test:completion && npm run test:providers && npm run test:menus",
    "test:model": "npm run test:model:compile && node --require ./test/node/registerVscodeStub.js --test ./test/node/hackmdModel.node.test.js",
    "test:commands:model": "npm run test:model:compile && node --require ./test/node/registerModelCommandsStub.js --test ./test/node/modelCommands.node.test.js",
    "test:commands:ui": "npm run test:model:compile && node --require ./test/node/registerUiCommandsStub.js --test ./test/node/uiCommands.node.test.js",
    "test:commands": "npm run test:commands:model && npm run test:commands:ui",
    "test:tree:dnd:compile": "tsc --ignoreConfig --pretty false --module commonjs --target es2020 --lib es2020,dom --outDir out --rootDir src --sourceMap --strict false --allowSyntheticDefaultImports --allowArbitraryExtensions --types node,jquery src/utils/treeDragAndDrop.ts",
    "test:tree:dnd": "npm run test:tree:dnd:compile && node --require ./test/node/registerTreeDragAndDropStub.js --test ./test/node/treeDragAndDrop.node.test.js",
    "test:fs:compile": "tsc --ignoreConfig --pretty false --module commonjs --target es2020 --lib es2020,dom --outDir out --rootDir src --sourceMap --strict false --allowSyntheticDefaultImports --allowArbitraryExtensions --types node,jquery src/model/index.ts src/model/hackmdModel.ts src/providers/mdFsProvider.ts",
    "test:fs:provider": "npm run test:fs:compile && node --require ./test/node/registerMdFsProviderStub.js --test ./test/node/mdFsProvider.node.test.js",
    "test:properties:compile": "tsc --ignoreConfig --pretty false --module commonjs --target es2020 --lib es2020,dom --outDir out --rootDir src --sourceMap --strict false --allowSyntheticDefaultImports --allowArbitraryExtensions --types node,jquery src/model/index.ts src/model/hackmdModel.ts src/providers/propertiesProvider.ts",
    "test:properties": "npm run test:properties:compile && node --require ./test/node/registerPropertiesProviderStub.js --test ./test/node/propertiesProvider.node.test.js",
    "test:completion:compile": "tsc --ignoreConfig --pretty false --module commonjs --target es2020 --lib es2020,dom --outDir out --rootDir src --sourceMap --strict false --allowSyntheticDefaultImports --allowArbitraryExtensions --types node,jquery src/model/index.ts src/model/hackmdModel.ts src/commands/pickers.ts src/providers/noteCompletionProvider.ts",
    "test:completion": "npm run test:completion:compile && node --require ./test/node/registerNoteCompletionProviderStub.js --test ./test/node/noteCompletionProvider.node.test.js",
