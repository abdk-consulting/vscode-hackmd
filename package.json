{
  "name": "vscode-hackmd",
  "displayName": "HackMD",
  "description": "The official HackMD Markdown VSCode extension",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "publisher": "HackMD",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#333333",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:HackMD.createCodeSnippet",
    "onView:hackmd.tree.my-notes",
    "onView:hackmd.tree.recent-notes",
    "onView:hackmd.tree.team-notes",
    "onCommand:HackMD.apiKey",
    "onCommand:HackMD.clearApiKey",
    "onCommand:HackMD.createActiveEditorContentToHackMD",
    "onCommand:HacKMD.openNoteOnHackMD",
    "onFileSystem:hackmd"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hackmdio/vscode-hackmd/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/hackmdio/vscode-hackmd/issues",
    "email": "support@hackmd.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hackmdio/vscode-hackmd.git"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "HackMD",
      "properties": {
        "Hackmd.apiEndPoint": {
          "type": "string",
          "default": "https://api.hackmd.io/v1/",
          "markdownDescription": "Specify the API endpoint for official instance or HackMD EE"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/page.js"
    ],
    "markdown.previewStyles": [
      "./dist/page.css"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackmd-tree",
          "title": "HackMD Notes",
          "icon": "images/icon/activity-bar.svg"
        }
      ]
    },
    "views": {
      "hackmd-tree": [
        {
          "id": "hackmd.tree.my-notes",
          "name": "My Notes"
        },
        {
          "id": "hackmd.tree.team-notes",
          "name": "Team Notes"
        },
        {
          "id": "hackmd.tree.recent-notes",
          "name": "Recent Notes"
        },
        {
          "id": "hackmd.properties",
          "name": "Note Properties",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "HackMD.createCodeSnippet",
        "title": "HackMD: Create a code snippet"
      },
      {
        "command": "HackMD.apiKey",
        "title": "API Key",
        "category": "HackMD"
      },
      {
        "command": "HackMD.clearApiKey",
        "title": "Clear API Key (for testing)",
        "category": "HackMD"
      },
      {
        "command": "treeView.refreshMyNotes",
        "title": "Refresh",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "treeView.createMyNotes",
        "title": "New Note",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/new-note.svg",
          "dark": "images/icon/dark/new-note.svg"
        }
      },
      {
        "command": "treeView.createMyFolder",
        "title": "New Folder...",
        "category": "HackMD",
        "icon": "$(new-folder)"
      },
      {
        "command": "treeView.refreshHistory",
        "title": "Refresh",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "treeView.refreshTeamNotes",
        "title": "Refresh",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "treeView.refreshSelectedTeam",
        "title": "Refresh Team",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/refresh.svg",
          "dark": "images/icon/dark/refresh.svg"
        }
      },
      {
        "command": "HackMD.folder.createNote",
        "title": "New Note",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/new-note.svg",
          "dark": "images/icon/dark/new-note.svg"
        }
      },
      {
        "command": "HackMD.folder.createFolder",
        "title": "New Folder...",
        "category": "HackMD",
        "icon": "$(new-folder)"
      },
      {
        "command": "treeView.importMyNotes",
        "title": "Import...",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/cloud-upload.svg",
          "dark": "images/icon/dark/cloud-upload.svg"
        }
      },
      {
        "command": "HackMD.folder.importNote",
        "title": "Import...",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/cloud-upload.svg",
          "dark": "images/icon/dark/cloud-upload.svg"
        }
      },
      {
        "command": "HackMD.folder.exportNote",
        "title": "Export...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.folder.rename",
        "title": "Rename...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.folder.delete",
        "title": "Delete...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.team.createNote",
        "title": "New Note",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/new-note.svg",
          "dark": "images/icon/dark/new-note.svg"
        }
      },
      {
        "command": "HackMD.team.createFolder",
        "title": "New Folder...",
        "category": "HackMD",
        "icon": "$(new-folder)"
      },
      {
        "command": "HackMD.team.importNote",
        "title": "Import...",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/cloud-upload.svg",
          "dark": "images/icon/dark/cloud-upload.svg"
        }
      },
      {
        "command": "HackMD.team.openOnHackMD",
        "title": "Open on HackMD",
        "category": "HackMD"
      },
      {
        "command": "HackMD.team.exportNotes",
        "title": "Export...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.folder.openOnWeb",
        "title": "Open on HackMD",
        "category": "HackMD"
      },
      {
        "command": "HackMD.showPreview",
        "title": "Preview",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/preview.svg",
          "dark": "images/icon/dark/preview.svg"
        }
      },
      {
        "command": "HackMD.showPreviewAndEditor",
        "title": "Side-by-Side",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/split-horizontal.svg",
          "dark": "images/icon/dark/split-horizontal.svg"
        }
      },
      {
        "command": "HackMD.createActiveEditorContentToHackMD",
        "title": "Create note from editor",
        "category": "HackMD"
      },
      {
        "command": "HacKMD.openNoteOnHackMD",
        "title": "Open on HackMD",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/link-external.svg",
          "dark": "images/icon/dark/link-external.svg"
        }
      },
      {
        "command": "HackMD.renameNote",
        "title": "Rename...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.moveNoteTo",
        "title": "Move...",
        "category": "HackMD",
        "enablement": "view != hackmd.tree.recent-notes"
      },
      {
        "command": "HackMD.duplicateNote",
        "title": "Duplicate",
        "category": "HackMD"
      },
      {
        "command": "HackMD.deleteMyNote",
        "title": "Delete...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.selectTeam",
        "title": "Select Team",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/folder.svg",
          "dark": "images/icon/dark/folder.svg"
        }
      },
      {
        "command": "HackMD.editNote",
        "title": "Edit",
        "category": "HackMD",
        "icon": {
          "light": "images/icon/light/edit.svg",
          "dark": "images/icon/dark/edit.svg"
        }
      },
      {
        "command": "HackMD.openNoteProperties",
        "title": "Properties...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.exportNote",
        "title": "Export...",
        "category": "HackMD"
      },
      {
        "command": "HackMD.upgrade",
        "title": "Upgrade",
        "category": "HackMD"
      },
      {
        "command": "hackmd.model.refreshAll",
        "title": "Refresh All Data",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.refreshTeams",
        "title": "Refresh Teams",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.refreshHistory",
        "title": "Refresh History",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.refreshScope",
        "title": "Refresh Scope",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getScopeSnapshot",
        "title": "Get Scope Snapshot",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getNote",
        "title": "Get Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getNoteContent",
        "title": "Get Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.getEntityByUri",
        "title": "Get Entity By URI",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.createNote",
        "title": "Create Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.createFolder",
        "title": "Create Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.loadNoteContent",
        "title": "Load Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.saveNoteContent",
        "title": "Save Note Content",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.updateNoteProperties",
        "title": "Update Note Properties",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.renameNote",
        "title": "Rename Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.renameFolder",
        "title": "Rename Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.updateFolder",
        "title": "Update Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.moveNote",
        "title": "Move Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.moveFolder",
        "title": "Move Folder",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.deleteNote",
        "title": "Delete Note",
        "category": "HackMD Model"
      },
      {
        "command": "hackmd.model.deleteFolder",
        "title": "Delete Folder",
        "category": "HackMD Model"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "treeView.refreshMyNotes",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@3"
        },
        {
          "command": "treeView.refreshHistory",
          "when": "view =~ /hackmd.tree.recent-notes/",
          "group": "navigation"
        },
        {
          "command": "treeView.refreshTeamNotes",
          "when": "view =~ /hackmd.tree.team-notes/",
          "group": "navigation"
        },
        {
          "command": "treeView.createMyNotes",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@1"
        },
        {
          "command": "treeView.createMyFolder",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@2"
        },
        {
          "command": "treeView.importMyNotes",
          "when": "view =~ /hackmd.tree.my-notes/",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "HackMD.editNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@1"
        },
        {
          "command": "HackMD.editNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@1"
        },
        {
          "command": "HackMD.showPreview",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@2"
        },
        {
          "command": "HackMD.showPreview",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@2"
        },
        {
          "command": "HackMD.showPreviewAndEditor",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@3"
        },
        {
          "command": "HackMD.showPreviewAndEditor",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "inline@3"
        },
        {
          "command": "HacKMD.openNoteOnHackMD",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "1_noteMain@4"
        },
        {
          "command": "HackMD.renameNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@2"
        },
        {
          "command": "HackMD.openNoteProperties",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@1"
        },
        {
          "command": "HackMD.moveNoteTo",
          "when": "((viewItem == file && ((view == hackmd.tree.my-notes && ((!hackmd.myNotesSelection.hasMixedSelection && (!hackmd.myNotesSelection.hasMultiNoteSelection || hackmd.myNotesSelection.hasSameScopeMultiNoteSelection)) || (hackmd.myNotesSelection.hasMixedSelection && hackmd.myNotesSelection.hasActionableSelection && hackmd.myNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.team-notes && ((!hackmd.teamNotesSelection.hasMixedSelection && (!hackmd.teamNotesSelection.hasMultiNoteSelection || hackmd.teamNotesSelection.hasSameScopeMultiNoteSelection)) || (hackmd.teamNotesSelection.hasMixedSelection && hackmd.teamNotesSelection.hasActionableSelection && hackmd.teamNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && (!hackmd.historySelection.hasMultiNoteSelection || hackmd.historySelection.hasSameScopeMultiNoteSelection)))) || ((viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending) && ((view == hackmd.tree.my-notes && (!hackmd.myNotesSelection.hasSelection || (hackmd.myNotesSelection.hasActionableSelection && hackmd.myNotesSelection.hasSingleScopeActionableSelection))) || (view == hackmd.tree.team-notes && (!hackmd.teamNotesSelection.hasSelection || (hackmd.teamNotesSelection.hasActionableSelection && hackmd.teamNotesSelection.hasSingleScopeActionableSelection))))) )",
          "group": "2_noteActions@3"
        },
        {
          "command": "HackMD.duplicateNote",
          "when": "viewItem == file && ((view == hackmd.tree.my-notes && !hackmd.myNotesSelection.hasMixedSelection && !hackmd.myNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.team-notes && !hackmd.teamNotesSelection.hasMixedSelection && !hackmd.teamNotesSelection.hasMultiNoteSelection) || (view == hackmd.tree.recent-notes && !hackmd.historySelection.hasMixedSelection && !hackmd.historySelection.hasMultiNoteSelection))",
          "group": "2_noteActions@4"
        },
        {
          "command": "HackMD.exportNote",
          "when": "((viewItem == file && ((view == hackmd.tree.my-notes && hackmd.myNotesSelection.hasActionableSelection) || (view == hackmd.tree.team-notes && hackmd.teamNotesSelection.hasActionableSelection) || (view == hackmd.tree.recent-notes && hackmd.historySelection.hasActionableSelection))) || ((viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending) && ((view == hackmd.tree.my-notes && hackmd.myNotesSelection.hasActionableSelection) || (view == hackmd.tree.team-notes && hackmd.teamNotesSelection.hasActionableSelection))))",
          "group": "2_noteActions@5"
        },
        {
          "command": "HackMD.deleteMyNote",
          "when": "((viewItem == file && ((view == hackmd.tree.my-notes && hackmd.myNotesSelection.hasActionableSelection) || (view == hackmd.tree.team-notes && hackmd.teamNotesSelection.hasActionableSelection) || (view == hackmd.tree.recent-notes && hackmd.historySelection.hasActionableSelection))) || ((viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending) && ((view == hackmd.tree.my-notes && hackmd.myNotesSelection.hasActionableSelection) || (view == hackmd.tree.team-notes && hackmd.teamNotesSelection.hasActionableSelection))))",
          "group": "3_noteDanger@1"
        },
        {
          "command": "HackMD.folder.createNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@1"
        },
        {
          "command": "HackMD.folder.createFolder",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@2"
        },
        {
          "command": "HackMD.folder.importNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "inline@3"
        },
        {
          "command": "HackMD.folder.createNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "1_folderActions@1"
        },
        {
          "command": "HackMD.folder.createFolder",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "1_folderActions@2"
        },
        {
          "command": "HackMD.folder.openOnWeb",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending)",
          "group": "1_folderActions@3"
        },
        {
          "command": "HackMD.folder.rename",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "2_folderManage@1"
        },
        {
          "command": "HackMD.folder.delete",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "2_folderManage@2"
        },
        {
          "command": "HackMD.folder.importNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "3_folderTransfer@1"
        },
        {
          "command": "HackMD.folder.exportNote",
          "when": "view =~ /hackmd.tree/ && (viewItem == folder || viewItem == folder-pending || viewItem == folder-no-client-id || viewItem == folder-no-client-id-pending)",
          "group": "3_folderTransfer@2"
        },
        {
          "command": "HackMD.team.createNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@1"
        },
        {
          "command": "HackMD.team.createFolder",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@2"
        },
        {
          "command": "HackMD.team.importNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "inline@3"
        },
        {
          "command": "HackMD.team.createNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@1"
        },
        {
          "command": "HackMD.team.createFolder",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@2"
        },
        {
          "command": "HackMD.team.openOnHackMD",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "1_teamMain@3"
        },
        {
          "command": "treeView.refreshSelectedTeam",
          "when": "view == hackmd.tree.team-notes && viewItem == team-loaded",
          "group": "1_teamMain@4"
        },
        {
          "command": "treeView.refreshSelectedTeam",
          "when": "view == hackmd.tree.team-notes && viewItem == team-loaded",
          "group": "inline@4"
        },
        {
          "command": "HackMD.team.importNote",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "2_teamTransfer@1"
        },
        {
          "command": "HackMD.team.exportNotes",
          "when": "view == hackmd.tree.team-notes && (viewItem == team || viewItem == team-loaded)",
          "group": "2_teamTransfer@2"
        }
      ]
    }
  },
